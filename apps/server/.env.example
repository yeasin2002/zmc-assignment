# Database Connection (Neon Serverless PostgreSQL or local PostgreSQL)
# Neon connection pooler URL (for runtime queries)
DATABASE_URL="postgresql://<user>:<password>@<neon-host>-pooler.ap-southeast-1.aws.neon.tech/verceldb?sslmode=require"
# Neon direct URL (for migrations and prisma commands)
DIRECT_URL="postgresql://<user>:<password>@<neon-host>.ap-southeast-1.aws.neon.tech/verceldb?sslmode=require"

# JWT Configuration
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"
PORT=3001

# Optional: Database credentials for Podman / Docker Compose (local development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zmc_assignment
POSTGRES_PORT=5432
